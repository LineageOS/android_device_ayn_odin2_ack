    stem: "adsp.mbn",
    mdt: "//vendor/ayn/odin2_ack:rp6_adsp_mdt",
    srcs: ["//vendor/ayn/odin2_ack:rp6_adsp"],
    relative_install_path: "qcom/sm8550/retroidpocket/rp6",
}
pil_squasher {
