prebuilt_firmware {
    name: "qcom-sm8550-odin2-tplg",
    srcs: [
        "qcom/sm8550/AYN-Odin2-tplg.bin",
    ],
    dsts: [
        "qcom/sm8550/AYN-Odin2-tplg.bin",
    ],
    vendor: true,
    required: [],
}

sh_binary_host {
    name: "ath12k-bdencoder",
    src: "ath12k-bdencoder",
}
filegroup {
    name: "board-2.json",
    srcs: ["board-2.json"],
}
genrule {
    name: "qcom-sm8550-ayn-board2-genrule",
    srcs: [
        "//external/linux-firmware-mainline:linux_firmware_ath12k-wcn7850-board2-group",
        ":board-2.json",
    ],
    out: ["board-2.bin"],
    tools: ["ath12k-bdencoder"],
    cmd: "$(location ath12k-bdencoder) -e $$(awk '{print $$1}' <<< \"$(in)\") && $(location ath12k-bdencoder) -c $$(awk '{print $$2}' <<< \"$(in)\") -o $(out)",
}
prebuilt_firmware {
    name: "qcom-sm8550-ayn-board2",
    srcs: [":qcom-sm8550-ayn-board2-genrule"],
    dsts: ["ath12k/WCN7850/hw2.0/board-2.bin"],
    vendor: true,
}

// This assumes that the last file in the filegroup is the .mdt
// Which should remain true for the alphabetically sorted groups created by the Lineage extract
genrule_defaults {
    name: "ayn-pil-squasher",
    tools: ["pil-squasher"],
    cmd: "$(location pil-squasher) $(out) $$(awk '{print $$NF}' <<< \"$(in)\")",
}

genrule {
    name: "qcom-sm8550-ayn-cdsp-genrule",
    defaults: ["ayn-pil-squasher"],
    srcs: ["//vendor/ayn/odin2_ack:cdsp"],
    out: ["cdsp.mbn"],
}
prebuilt_firmware {
    name: "qcom-sm8550-ayn-cdsp",
    srcs: [":qcom-sm8550-ayn-cdsp-genrule"],
    dsts: ["qcom/sm8550/ayntec/cdsp.mbn"],
    vendor: true,
    vendor_ramdisk_available: true,
}

genrule {
    name: "qcom-sm8550-ayn-cdsp-dtb-genrule",
    defaults: ["ayn-pil-squasher"],
    srcs: ["//vendor/ayn/odin2_ack:cdsp_dtb"],
    out: ["cdsp_dtb.mbn"],
}
prebuilt_firmware {
    name: "qcom-sm8550-ayn-cdsp-dtb",
    srcs: [":qcom-sm8550-ayn-cdsp-dtb-genrule"],
    dsts: ["qcom/sm8550/ayntec/cdsp_dtb.mbn"],
    vendor: true,
    vendor_ramdisk_available: true,
}

