prebuilt_firmware {
    name: "qcom-sm8550-ayn-odin2mini-edids",
    srcs: [
        "qcom/sm8550/ayntec/odin2mini/1080x1920.edid",
    ],
    dsts: [
        "qcom/sm8550/ayntec/odin2mini/1080x1920.edid",
    ],
    vendor: true,
}

prebuilt_firmware {
    name: "qcom-sm8550-ayn-odin2portal-edids",
    srcs: [
        "qcom/sm8550/ayntec/odin2portal/1080x1920.edid",
    ],
    dsts: [
