    srcs: ["//vendor/ayn/odin2_ack:odin2portal_adsp"],
    relative_install_path: "qcom/sm8550/ayntec/odin2portal",
}
pil_squasher {
    name: "qcom-sm8550-ayn-odin2portal-adsp-dtb",
    stem: "adsp_dtb.mbn",
    mdt: "//vendor/ayn/odin2_ack:odin2portal_adsp_dtb_mdt",
    srcs: ["//vendor/ayn/odin2_ack:odin2portal_adsp_dtb"],
    relative_install_path: "qcom/sm8550/ayntec/odin2portal",
