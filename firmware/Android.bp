pil_squasher {
    name: "qcom-sm8550-ayn-cdsp",
    stem: "cdsp.mbn",
    mdt: "//vendor/ayn/odin2_ack:cdsp_mdt",
    srcs: ["//vendor/ayn/odin2_ack:cdsp"],
    relative_install_path: "qcom/sm8550/ayntec",
}
