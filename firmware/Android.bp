sh_binary_host {
    name: "ath12k-bdencoder",
    src: "ath12k-bdencoder",
}
filegroup {
    name: "board-2.json",
    srcs: ["board-2.json"],
}
genrule {
    name: "qcom-sm8550-ayn-board2-genrule",
    srcs: [
        "//external/linux-firmware-mainline:linux_firmware_ath12k-wcn7850-board2-group",
        ":board-2.json",
    ],
    out: ["board-2.bin"],
    tools: ["ath12k-bdencoder"],
    cmd: "$(location ath12k-bdencoder) -e $$(awk '{print $$1}' <<< \"$(in)\") && $(location ath12k-bdencoder) -c $$(awk '{print $$2}' <<< \"$(in)\") -o $(out)",
}
prebuilt_firmware {
    name: "qcom-sm8550-ayn-board2",
    srcs: [":qcom-sm8550-ayn-board2-genrule"],
    dsts: ["ath12k/WCN7850/hw2.0/board-2.bin"],
    vendor: true,
}

pil_squasher {
    name: "qcom-sm8550-ayn-cdsp",
    stem: "cdsp.mbn",
    mdt: "//vendor/ayn/odin2_ack:cdsp_mdt",
    srcs: ["//vendor/ayn/odin2_ack:cdsp"],
    relative_install_path: "qcom/sm8550/ayntec",
}
pil_squasher {
    name: "qcom-sm8550-ayn-cdsp-dtb",
    stem: "cdsp_dtb.mbn",
    mdt: "//vendor/ayn/odin2_ack:cdsp_dtb_mdt",
    srcs: ["//vendor/ayn/odin2_ack:cdsp_dtb"],
    relative_install_path: "qcom/sm8550/ayntec",
}

pil_squasher {
    name: "qcom-sm8550-ayn-odin2-adsp",
    stem: "adsp.mbn",
    mdt: "//vendor/ayn/odin2_ack:odin2_adsp_mdt",
    srcs: ["//vendor/ayn/odin2_ack:odin2_adsp"],
    relative_install_path: "qcom/sm8550/ayntec/odin2",
}
pil_squasher {
    name: "qcom-sm8550-ayn-odin2-adsp-dtb",
    stem: "adsp_dtb.mbn",
    mdt: "//vendor/ayn/odin2_ack:odin2_adsp_dtb_mdt",
    srcs: ["//vendor/ayn/odin2_ack:odin2_adsp_dtb"],
    relative_install_path: "qcom/sm8550/ayntec/odin2",
}

pil_squasher {
    name: "qcom-sm8550-ayn-odin2mini-adsp",
    stem: "adsp.mbn",
    mdt: "//vendor/ayn/odin2_ack:odin2mini_adsp_mdt",
    srcs: ["//vendor/ayn/odin2_ack:odin2mini_adsp"],
    relative_install_path: "qcom/sm8550/ayntec/odin2mini",
}
pil_squasher {
    name: "qcom-sm8550-ayn-odin2mini-adsp-dtb",
    stem: "adsp_dtb.mbn",
    mdt: "//vendor/ayn/odin2_ack:odin2mini_adsp_dtb_mdt",
    srcs: ["//vendor/ayn/odin2_ack:odin2mini_adsp_dtb"],
    relative_install_path: "qcom/sm8550/ayntec/odin2mini",
}

pil_squasher {
    name: "qcom-sm8550-ayn-odin2portal-adsp",
    stem: "adsp.mbn",
