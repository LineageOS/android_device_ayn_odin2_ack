phony {
    name: "qcom-sm8550-ayn",
    required: [
        "qcom-sm8550-ayn-board2",
        "qcom-sm8550-ayn-cdsp",
        "qcom-sm8550-ayn-cdsp-dtb",
        "qcom-sm8550-ayn-odin2-adsp",
        "qcom-sm8550-ayn-odin2-adsp-dtb",
        "qcom-sm8550-ayn-odin2mini-adsp",
        "qcom-sm8550-ayn-odin2mini-adsp-dtb",
        "qcom-sm8550-ayn-odin2portal-adsp",
        "qcom-sm8550-ayn-odin2portal-adsp-dtb",
        "qcom-sm8550-ayn-thor-adsp",
        "qcom-sm8550-ayn-thor-adsp-dtb",
        "qcom-sm8550-ayn-cdsp.vendor_ramdisk",
        "qcom-sm8550-ayn-cdsp-dtb.vendor_ramdisk",
        "qcom-sm8550-ayn-odin2-adsp.vendor_ramdisk",
        "qcom-sm8550-ayn-odin2-adsp-dtb.vendor_ramdisk",
        "qcom-sm8550-ayn-odin2mini-adsp.vendor_ramdisk",
        "qcom-sm8550-ayn-odin2mini-adsp-dtb.vendor_ramdisk",
        "qcom-sm8550-ayn-odin2portal-adsp.vendor_ramdisk",
        "qcom-sm8550-ayn-odin2portal-adsp-dtb.vendor_ramdisk",
        "qcom-sm8550-ayn-thor-adsp.vendor_ramdisk",
        "qcom-sm8550-ayn-thor-adsp-dtb.vendor_ramdisk",
    ],
}
