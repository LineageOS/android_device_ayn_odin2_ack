      "message": "```suggestion\n\n/*\n * SPDX-FileCopyrightText: The LineageOS Project\n * SPDX-License-Identifier: Apache-2.0\n */\n \n#define LOG_TAG \"odin2_init\"\n\n#include \u003candroid-base/logging.h\u003e\n#include \u003candroid-base/properties.h\u003e\n#include \u003clibinit_mainline_common.h\u003e\n#include \u003clibinit_utils.h\u003e\n\n#include \"vendor_init.h\"\n\n#include \u003cstring\u003e\n#include \u003cunordered_map\u003e\n\nusing android::base::GetProperty;\n\nstruct odin2_device {\n    std::string device;\n    std::string name;\n    std::string model;\n\n} typedef odin2_device;\n\nstatic std::unordered_map\u003cstd::string, odin2_device\u003e kOdin2Devices \u003d {\n        {\"odin2\", {\"odin2\", \"odin2\", \"Odin 2\"}},\n        {\"odin2mini\", {\"odin2\", \"odin2mini\", \"Odin 2 Mini\"}},\n        {\"odin2portal\", {\"odin2\", \"odin2portal\", \"Odin 2 Portal\"}},\n        {\"thor\", {\"odin2\", \"thor\", \"Thor\"}},\n};\n\nstatic void set_odin2_device_properties(void) {\n    auto hardware \u003d GetProperty(\"ro.hardware\", \"\");\n    if (hardware.empty()) return;\n\n    auto it \u003d kOdin2Devices.find(hardware);\n    if (it \u003d\u003d kOdin2Devices.end()) {\n        LOG(ERROR) \u003c\u003c \"could not detect model, aborting\";\n        return;\n    }\n\n    auto chosen_device \u003d it-\u003esecond;\n    property_override(\"ro.build.product\", chosen_device.device);\n    property_override(\"ro.product.device\", chosen_device.device);\n    property_override(\"ro.product.model\", chosen_device.model);\n    property_override(\"ro.product.name\", chosen_device.name);\n    set_ro_build_prop(\"device\", chosen_device.device, true);\n    set_ro_build_prop(\"model\", chosen_device.model, true);\n    set_ro_build_prop(\"name\", chosen_device.name, true);\n}\n\nvoid vendor_load_properties() {\n    vendor_load_properties_mainline_common();\n    set_odin2_device_properties();\n}\n```",
