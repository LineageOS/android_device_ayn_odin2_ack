install_symlink {
    name: "device_state_symlink",
    vendor: true,
    installed_location: "etc/displayconfig/device_state_configuration.xml",
    symlink_target: "/metadata/vendor/displayconfig/device_state_configuration.xml",
}

install_symlink {
    name: "display_layout_symlink",
    vendor: true,
    installed_location: "etc/displayconfig/display_layout_configuration.xml",
    symlink_target: "/metadata/vendor/displayconfig/display_layout_configuration.xml",
}
